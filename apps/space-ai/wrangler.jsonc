{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "space-ai",
  "main": "src/server.ts",
  "compatibility_date": "2026-11-04",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "secrets": {
    "required": [
      "ACCESS_TEAM_DOMAIN",
      "ACCESS_AUD",
      "ACCESS_ALLOWED_EMAIL"
    ]
  },
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agents/*", "/api/*"]
  },
  "containers": [
    {
      "class_name": "SandboxRunner",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "dockerfile": "./sandbox/Dockerfile"
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SpaceAgent",
        "class_name": "SpaceAgent"
      },
      {
        "name": "SandboxRunner",
        "class_name": "SandboxRunner"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SpaceAgent"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["SandboxRunner"]
    }
  ],
  "vars": {
    "DEPLOYMENT_ENV": "production"
  }
}
