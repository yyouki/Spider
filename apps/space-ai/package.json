{
  "name": "space-ai",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "The first persistent single-core AI workspace for space.",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "types": "wrangler types env.d.ts",
    "test": "node --test src/security/tenant-routing.test.js src/security/connection-diagnosis.test.js src/self-update/release-gate.test.js src/sandbox/execution-policy.test.js ../../scripts/sandbox-runtime.test.mjs",
    "check": "npm run types && tsc --noEmit && npm test",
    "deploy": "npm run check && vite build && wrangler deploy"
  },
  "dependencies": {
    "@cloudflare/ai-chat": "0.12.2",
    "agents": "0.32.0",
    "@ai-sdk/provider": "4.0.35",
    "@ai-sdk/react": "4.0.167",
    "ai": "7.0.162",
    "fflate": "0.8.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.4.3",
    "codemirror": "^6.0.2",
    "@codemirror/language-data": "^6.5.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.67.0",
    "@types/node": "26.0.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "typescript": "6.0.3",
    "vite": "8.1.0",
    "wrangler": "4.157.0"
  }
}
